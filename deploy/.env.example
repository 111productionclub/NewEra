# Скопируйте в .env на сервере и заполните. Файл .env в git не попадает.
# Секретный ключ: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# newera-backend: по этому имени сборка сайта (rebuild-site.sh) обращается к API внутри сети Docker
DJANGO_ALLOWED_HOSTS=mynewerastore.ru,www.mynewerastore.ru,newera-backend
CSRF_TRUSTED_ORIGINS=https://mynewerastore.ru
CORS_ALLOWED_ORIGINS=https://mynewerastore.ru
