# Скопируйте в .env на сервере и заполните. Файл .env в git не попадает.
# Секретный ключ: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=newerastore.ru,www.newerastore.ru
CSRF_TRUSTED_ORIGINS=https://newerastore.ru
CORS_ALLOWED_ORIGINS=https://newerastore.ru
